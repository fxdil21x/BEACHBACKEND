PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/beach-verification
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=your_refresh_secret_here
